# Copy to .env (never commit your real .env) and fill in your own values.
# This tool only ever logs into YOUR OWN WeMust account.

# Your MUST student ID / WeMust username (required)
WEMUST_USERNAME=your_student_id

# Password: RECOMMENDED to store in the macOS Keychain instead of here:
#   security add-generic-password -U -s wemust -a your_student_id -w
# (you will be prompted for the password; it is not stored in shell history)
# Keychain service name (default: wemust)
# WEMUST_KEYCHAIN_SERVICE=wemust
#
# Less safe fallback: put the password in the environment instead of the Keychain.
# WEMUST_PASSWORD=your_password

# Windows: windows/setup-credentials.ps1 can store a DPAPI-encrypted credential.
# Optional executable used by windows/start-mcp.ps1 (default: python on PATH).
# WEMUST_PYTHON=C:\path\to\python.exe

# --- Grades (OFF by default) ---
# Setting this to 1 registers the get_grades MCP tool, which means your grade
# values (courses, final grades, GPA/CGPA) will be sent to the connected LLM
# client. Leave it unset unless you really want that.
# WEMUST_ENABLE_GRADES=1

# --- Optional Notion sync (CLI `sync`; not used by the MCP server) ---
# WEMUST_NOTION_PAGE_ID=xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
# Token via Keychain (recommended):
#   security add-generic-password -U -s wemust-notion -a notion -w
# WEMUST_NOTION_KEYCHAIN_SERVICE=wemust-notion
# WEMUST_NOTION_KEYCHAIN_ACCOUNT=notion
# or less safe:
# WEMUST_NOTION_TOKEN=secret_xxx
